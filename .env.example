# EduTrust DEV environment only. Never commit real secrets.
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-only-django-secret-change-me
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_URL=postgresql://user:password@localhost:5432/edutrust_dev
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000
MOCK_PAYMENT_PROVIDER_ENABLED=true
REAL_PAYMENT_ENABLED=false
REAL_PAYOUT_ENABLED=false
